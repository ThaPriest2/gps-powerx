# ───────────── GPS PowerX environment ─────────────
# Copy to .env. Never commit .env. Never expose the API key to the browser:
# all postcode calls go through the Express server (server/postcodeService.js).

# --- Mode ---------------------------------------------------------------
# Leave the API values below empty to run in DEMO MODE automatically.
# Set DEMO_MODE=true to FORCE demo mode even when credentials exist (safest for a live pitch).
DEMO_MODE=false

# If the live API fails and the postcode is one of the built-in TEST postcodes,
# fall back to test data (clearly labelled "TEST DATA — not live"). Set to false to disable.
PITCH_FALLBACK=true

# --- Official NIPOST Digital Postcode API --------------------------------
# Fill these in from the official API documentation / your developer portal.
POSTCODE_API_BASE_URL=
POSTCODE_API_KEY=

# Lookup path appended to the base URL. {code} is replaced with the postcode.
POSTCODE_API_LOOKUP_PATH=/postcode/{code}

# How the key is sent. Default: "Authorization: Bearer <key>".
# For an "x-api-key: <key>" style API use HEADER=x-api-key and SCHEME= (empty).
POSTCODE_API_KEY_HEADER=Authorization
POSTCODE_API_KEY_SCHEME=Bearer
POSTCODE_API_TIMEOUT_MS=8000

# --- Server -------------------------------------------------------------
PORT=8787
